# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE and Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Ephemeral Uploads and Exports (Keep folder structure via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/exports/*
!data/exports/.gitkeep

# SQLite database files (Seed script generates clean database on install)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
*.log
